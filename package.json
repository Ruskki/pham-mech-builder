{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.BUILD_TARGET='\"static\"'",
    "build:exe": "bun build --compile src/index.ts --define:process.env.BUILD_TARGET='\"server\"'",
    "build:exe:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --define:process.env.BUILD_TARGET='\"server\"'",
    "build:exe:win": "bun build --compile --target=bun-windows-x64 src/index.ts --define:process.env.BUILD_TARGET='\"server\"'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7.0.2"
  }
}
